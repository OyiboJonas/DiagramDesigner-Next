{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiagramDesigner Next",
  "version": "0.1.0-alpha.1",
  "identifier": "de.diagramdesigner.next",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DiagramDesigner Next Alpha",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-editor", "renderer-benchmark"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
