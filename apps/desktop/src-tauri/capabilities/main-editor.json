{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-editor",
  "description": "Minimal local capability for the DiagramDesigner Next editor window. Filesystem and dialog plugin commands are intentionally not exposed to the WebView.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-document-state",
    "allow-document-navigation",
    "allow-activate-page",
    "allow-activate-layer",
    "allow-create-page",
    "allow-delete-page",
    "allow-update-page-properties",
    "allow-create-layer",
    "allow-delete-layer",
    "allow-update-layer-properties",
    "allow-candidate-page-presentation",
    "allow-set-selection",
    "allow-selection-properties",
    "allow-group-selection",
    "allow-ungroup-selection",
    "allow-reorder-selection",
    "allow-copy-selection",
    "allow-paste-selection",
    "allow-duplicate-selection",
    "allow-create-basic-element",
    "allow-create-connector",
    "allow-set-connector-endpoint",
    "allow-update-connector-style",
    "allow-delete-selection",
    "allow-update-element-properties",
    "allow-update-element-appearance",
    "allow-new-document",
    "allow-open-document",
    "allow-save-document",
    "allow-save-as-document",
    "allow-recovery-status",
    "allow-restore-recovery",
    "allow-discard-recovery",
    "allow-sync-recovery",
    "allow-undo",
    "allow-redo",
    "allow-commit-move-elements",
    "allow-open-renderer-benchmark"
  ]
}
